<dialog class="art-viewer" id="art-viewer" aria-labelledby="viewer-title">
  <div class="viewer-shell">
    <button class="viewer-close" type="button" aria-label="Close artwork viewer" data-close-viewer>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5 5 19 19M19 5 5 19" />
      </svg>
    </button>
    <div class="viewer-meta" aria-live="polite" aria-atomic="true">
      <span class="viewer-count" id="viewer-count"></span>
      <h2 id="viewer-title"></h2>
    </div>
    <div class="viewer-image-wrap">
      <button class="viewer-nav viewer-prev" type="button" aria-label="Previous artwork" data-viewer-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m15 5-7 7 7 7" />
        </svg>
      </button>
      <img class="viewer-image" id="viewer-image" alt="" />
      <button class="viewer-nav viewer-next" type="button" aria-label="Next artwork" data-viewer-next>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>
    </div>
    <button class="reveal-note" id="reveal-note" type="button" hidden>
      What to notice
    </button>
    <p class="viewer-note" id="viewer-note" hidden></p>
  </div>
</dialog>
